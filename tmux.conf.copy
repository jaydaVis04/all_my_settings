# Pane borders
set -g pane-border-style "fg=#555555"
set -g pane-active-border-style "fg=white"

# Status bar
set -g status-style "bg=#1c1c1c,fg=#aaaaaa"

# Current window = orange
set -g window-status-current-style "fg=#ff8700,bold"

# Other windows = faded
set -g window-status-style "fg=#666666"

# Left/right status accents
set -g status-left-style "fg=#ff8700"
set -g status-right-style "fg=#ff8700"

# Messages / command prompt
set -g message-style "bg=#ff8700,fg=black"

# Pane number shown with Ctrl-a q
set -g display-panes-active-colour white
set -g display-panes-colour "#ff8700"
